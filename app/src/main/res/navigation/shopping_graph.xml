<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shopping_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/cartFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.CartFragment"
        android:label="CartFragment"
        tools:layout="@layout/fragment_shopping_cart" >
        <action
            android:id="@+id/action_cartFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_cartFragment_to_billingFragment"
            app:destination="@id/billingFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_shopping_home" >
        <action
            android:id="@+id/action_homeFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_cameraScannerFragment"
            app:destination="@id/cameraScannerFragment"
            app:launchSingleTop="true"
            app:popUpTo="@+id/homeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search_bar">
        <action
            android:id="@+id/action_searchFragment_to_searchSuggestionFragment"
            app:destination="@id/searchSuggestionFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_userAccountFragment"
            app:destination="@id/userAccountFragment" />
        <action
            android:id="@+id/action_profileFragment_to_ordersFragment"
            app:destination="@id/ordersFragment" />
        <action
            android:id="@+id/action_profileFragment_to_billingFragment"
            app:destination="@id/billingFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.ProductDetailsFragment"
        android:label="ProductDetailsFragment"
        tools:layout="@layout/fragment_shopping_product_details">
        <argument
            android:name="product"
            app:argType="edu.utsa.cs3443.skyboltecommerceapp.Data.Product" />
    </fragment>
    <fragment
        android:id="@+id/addressFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.AddressFragment"
        android:label="AddressFragment"
        tools:layout="@layout/fragment_address">
        <argument
            android:name="address"
            app:argType="edu.utsa.cs3443.skyboltecommerceapp.Data.Address"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/billingFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Shopping.BillingFragment"
        android:label="BillingFragment"
        tools:layout="@layout/fragment_billing">
        <action
            android:id="@+id/action_billingFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <argument
            android:name="totalPrice"
            app:argType="float" />
        <argument
            android:name="product"
            app:argType="edu.utsa.cs3443.skyboltecommerceapp.Data.CartProduct[]" />
        <argument
            android:name="payment"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/userAccountFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Settings.UserAccountFragment"
        android:label="UserAccountFragment"
        tools:layout="@layout/fragment_user_account"/>
    <fragment
        android:id="@+id/ordersFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Settings.AllOrdersFragment"
        android:label="OrdersFragment"
        tools:layout="@layout/fragment_orders">
        <action
            android:id="@+id/action_ordersFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Settings.OrderDetailFragment"
        android:label="OrderDetailFragment"
        tools:layout="@layout/fragment_order_detail">
        <argument
            android:name="order"
            app:argType="edu.utsa.cs3443.skyboltecommerceapp.Data.Order" />
    </fragment>
    <fragment
        android:id="@+id/searchResultFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Searching.SearchResultFragment"
        android:label="SearchResultFragment"
        tools:layout="@layout/fragment_search_results">
        <action
            android:id="@+id/action_searchResultFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchSuggestionFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Searching.SearchSuggestionFragment"
        android:label="SearchSuggestionFragment"
        tools:layout="@layout/fragment_search_suggestions">
        <action
            android:id="@+id/action_searchSuggestionFragment_to_searchResultFragment"
            app:destination="@id/searchResultFragment" />
    </fragment>
    <fragment
        android:id="@+id/cameraScannerFragment"
        android:name="edu.utsa.cs3443.skyboltecommerceapp.Fragments.Searching.CameraScannerFragment"
        android:label="CameraScannerFragment" />
</navigation>