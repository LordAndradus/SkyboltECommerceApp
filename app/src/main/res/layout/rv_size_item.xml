<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/rectShadow"
        android:layout_width="60dp"
        android:layout_height="25dp"
        android:background="@drawable/blue_background"
        android:src="#B8D9FA"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/rectImage"
        android:layout_width="58dp"
        android:layout_height="23dp"
        android:background="@drawable/rectangle"
        android:backgroundTint="@color/g_gray700"
        android:src="@color/g_blue"
        app:layout_constraintStart_toStartOf="@id/rectShadow"
        app:layout_constraintEnd_toEndOf="@id/rectShadow"
        app:layout_constraintTop_toTopOf="@id/rectShadow"
        app:layout_constraintBottom_toBottomOf="@id/rectShadow"
        />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_picked"
        app:layout_constraintStart_toStartOf="@id/rectImage"
        app:layout_constraintTop_toTopOf="@id/rectImage"
        app:layout_constraintEnd_toEndOf="@id/rectImage"
        app:layout_constraintBottom_toBottomOf="@id/rectImage"
        android:text="Small"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="@color/white"
        />



</androidx.constraintlayout.widget.ConstraintLayout>